# Backend environment variables example
# Copy this file to .env for local development.
# NEVER commit .env to git.
#
# For production (Render), set these in:
#   Render Dashboard → Service → Environment → Add Environment Variable

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.gp5ayhl.mongodb.net/PreparationOS?retryWrites=true&w=majority

# ── Server Port ──────────────────────────────────────────────────────────────
PORT=3001

# ── JWT Secret ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-strong-random-secret-here

# ── WebAuthn / Passkey Configuration ────────────────────────────────────────
# CRITICAL: The RP ID MUST match the FRONTEND domain (not the backend/Render hostname).
#
# Local development (leave commented out — defaults to localhost):
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_EXPECTED_ORIGIN=http://localhost:5173
#
# Production — set BOTH of these in Render dashboard:
WEBAUTHN_RP_ID=preparation-os.vercel.app
WEBAUTHN_EXPECTED_ORIGIN=https://preparation-os.vercel.app
