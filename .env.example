# Frontend environment variables example
# Copy this file to .env and fill in values for local development.
# NEVER commit .env to git.
#
# For production (Vercel), set variables in:
#   Vercel Dashboard → Project → Settings → Environment Variables

# ── API Backend URL ──────────────────────────────────────────────────────────
# Leave EMPTY for local dev (Vite proxy handles /api/* → localhost:3001).
# For production Vercel build, set to your Render backend:
#   VITE_API_URL=https://preparation-os.onrender.com/api
VITE_API_URL=

# ── WebAuthn RP ID ───────────────────────────────────────────────────────────
# Local dev: localhost
# Production Vercel: preparation-os.vercel.app
VITE_WEBAUTHN_RP_ID=localhost

# ── App Origin ───────────────────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: https://preparation-os.vercel.app
VITE_APP_ORIGIN=http://localhost:5173
